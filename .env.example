# ============================================================
# .env - DataMarketplace Blockchain Configuration
# ⚠️  Ne jamais committer ce fichier sur Git !
# ============================================================

# === WALLET ===
# Clé privée du wallet de déploiement (sans le 0x)
PRIVATE_KEY=your_private_key_here

# === RPC ENDPOINTS ===
POLYGON_MUMBAI_RPC=https://rpc-mumbai.maticvigil.com
POLYGON_RPC=https://polygon-rpc.com
ETHEREUM_SEPOLIA_RPC=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# === API KEYS ===
INFURA_KEY=your_infura_project_id
POLYGONSCAN_API_KEY=your_polygonscan_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key

# === IPFS - PINATA ===
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET=your_pinata_secret_key

# === OPTIONNEL ===
CMC_API_KEY=your_coinmarketcap_api_key  # Pour gas reporter en USD
REPORT_GAS=false
